+// androidGuest 判断当前是否跑在 Android 用户态。
+// 用文件探测而不是 build tag，是因为 GOOS=linux 的二进制同样会被放到手机上跑，
+// 而文件名后缀 _linux_ 的代码在 android 目标下也会被编译进来。
+func androidGuest() bool {
+	if runtime.GOOS == "android" {
+		return true
+	}
+	// 任一条存在即可判定为 Android 用户态，全部失败才会退回探测路径
+	for _, p := range []string{
+		"/system/bin/linker64",
+		"/system/bin/linker",
+		"/system/bin/app_process64",
+		"/system/bin/app_process",
+		"/system/build.prop",
+	} {
+		if _, err := os.Stat(p); err == nil {
+			return true
+		}
+	}
+	return false
+}
